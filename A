Players.PlayerRemoving:Connect(removeESP)

local function updateESP()
    if not Config.ESPEnabled then
        for _, data in pairs(espObjects) do data.box.Visible = false end
        return
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for player, data in pairs(espObjects) do
        local enemy = isEnemy(player)
        local shouldShow = enemy and Config.ESPEnemies or (not enemy and Config.ESPTeammates)
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if shouldShow and char and head and rootPart and humanoid and humanoid.Health > 0 then
            local topPos, topOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.2, 0))
            local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
            if topOnScreen and bottomOnScreen then
                local height = math.abs(bottomPos.Y - topPos.Y)
                local width = height / 2
                local isLocked = (Config.AimLockTarget == player)
                local color = isLocked and Config.ESPLockColor or (enemy and Config.ESPEnemyColor or Config.ESPTeamColor)
                data.box.Visible = true
                data.box.Position = UDim2.fromOffset(topPos.X - width / 2, topPos.Y)
                data.box.Size = UDim2.fromOffset(width, height)
                data.outline.Color = color
                data.name.Visible = Config.ESPName
                data.name.Text = (isLocked and "[고정] " or "") .. player.Name
                data.name.TextColor3 = color
                data.name.Size = UDim2.new(1, 0, 0, math.clamp(height * 0.12, 12, 22))
                data.name.Position = UDim2.new(0, 0, 0, -data.name.Size.Y.Offset - 2)
                data.health.Visible = Config.ESPHealth
                data.health.Size = UDim2.new(0, 3, humanoid.Health / humanoid.MaxHealth, 0)
                local hpRatio = humanoid.Health / humanoid.MaxHealth
                data.health.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpRatio), 255 * hpRatio, 0)
                data.distance.Visible = Config.ESPDistance and myRoot ~= nil
                if myRoot then
                    local dist = (rootPart.Position - myRoot.Position).Magnitude
                    data.distance.Text = string.format("[%dm]", math.floor(dist))
                    data.distance.TextColor3 = color
                end
                data.distance.Position = UDim2.new(0, 0, 1, 2)
            else
                data.box.Visible = false
            end
        else
            data.box.Visible = false
        end
    end
end
RunService.RenderStepped:Connect(updateESP)

