local function calculatePhoneSize()
    local vp = Camera.ViewportSize
    if vp.X <= 0 or vp.Y <= 0 then vp = Vector2.new(1920, 1080) end
    local targetH = vp.Y * 0.85
    local targetW = targetH * (9 / 19.5)
    local maxW = vp.X * 0.35
    if targetW > maxW then
        targetW = maxW
        targetH = targetW * (19.5 / 9)
    end
    return math.floor(targetW), math.floor(targetH)
end

