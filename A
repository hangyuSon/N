--==========================================================================
--  팀 판별
--==========================================================================
local function getTeamId(player)
    local ok, id = pcall(function() return player:GetAttribute("TeamID") end)
    if ok and id ~= nil then return id end
    if player.Team then return player.Team end
    return nil
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myTeam = getTeamId(LocalPlayer)
    local theirTeam = getTeamId(player)
    if myTeam == nil or theirTeam == nil then return true end
    return myTeam ~= theirTeam
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    return hum ~= nil and hum.Health > 0 and head ~= nil
end

--==========================================================================
--  타겟
--==========================================================================
local function getClosestTarget()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, Config.AimbotFOV
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not (Config.AimbotTeamCheck and not isEnemy(player)) then
                local char = player.Character
                if char then
                    local head = char:FindFirstChild("Head")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if head and humanoid and humanoid.Health > 0 then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = { player = player, part = head }
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function updateAimLockTarget()
    if not Config.AimLockEnabled then Config.AimLockTarget = nil; return end
    if Config.AimLockTarget then
        local tgt = Config.AimLockTarget
        if not tgt.Parent or not isAlive(tgt) then
            Config.AimLockTarget = nil
        else
            local head = tgt.Character and tgt.Character:FindFirstChild("Head")
            if head then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot and (head.Position - myRoot.Position).Magnitude > Config.AimLockBreakDist then
                    Config.AimLockTarget = nil
                end
            end
        end
    end
    if not Config.AimLockTarget then
        local best = getClosestTarget()
        if best then Config.AimLockTarget = best.player end
    end
end

local function getAimTarget()
    if Config.AimLockTarget then
        local tgt = Config.AimLockTarget
        if isAlive(tgt) then
            local head = tgt.Character and tgt.Character:FindFirstChild("Head")
            if head then return { player = tgt, part = head } end
        end
    end
    return getClosestTarget()
end

--==========================================================================
--  대상 자동 해제
--==========================================================================
local function watchTarget(player)
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Died:Once(function()
                if Config.AimLockTarget == player then Config.AimLockTarget = nil end
            end)
        end
    end
    player.CharacterAdded:Connect(function()
        if Config.AimLockTarget == player then Config.AimLockTarget = nil end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        if p.Character then watchTarget(p) end
        p.CharacterAdded:Connect(function() watchTarget(p) end)
    end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then
        if p.Character then watchTarget(p) end
        p.CharacterAdded:Connect(function() watchTarget(p) end)
    end
end)
Players.PlayerRemoving:Connect(function(p)
    if Config.AimLockTarget == p then Config.AimLockTarget = nil end
end)

