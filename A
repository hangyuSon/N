    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.fromOffset(56, 12)
    titleLbl.Size = UDim2.new(1, -70, 0, 20)
    titleLbl.Font = Enum.Font.Gotham
    titleLbl.TextSize = 14
    titleLbl.TextColor3 = Color3.fromRGB(0, 0, 0)
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 8
    titleLbl.Parent = row

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Text = string.format("%.2f", opts.getter())
    valueLbl.BackgroundTransparency = 1
    valueLbl.AnchorPoint = Vector2.new(1, 0)
    valueLbl.Position = UDim2.new(1, -16, 0, 12)
    valueLbl.Size = UDim2.fromOffset(70, 20)
    valueLbl.Font = Enum.Font.Gotham
    valueLbl.TextSize = 14
    valueLbl.TextColor3 = Color3.fromRGB(140, 140, 145)
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.ZIndex = 8
    valueLbl.Parent = row

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(56, 44)
    track.Size = UDim2.new(1, -72, 0, 4)
    track.BackgroundColor3 = Color3.fromRGB(229, 229, 234)
    track.BorderSizePixel = 0
    track.ZIndex = 8
    track.Parent = row
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((opts.getter() - opts.min) / (opts.max - opts.min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
    fill.BorderSizePixel = 0
    fill.ZIndex = 9
    fill.Parent = track
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local dragging = false
    local function updateFromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = opts.min + (opts.max - opts.min) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valueLbl.Text = string.format("%.2f", value)
        opts.setter(value)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return row
end

