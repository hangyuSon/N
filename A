local isMinimized = false

local function minimizeUI()
    if isMinimized then return end
    isMinimized = true

    --  로고를 UI와 같은 위치로 이동
    logoBtn.Position = wrapper.Position

    --  축소 애니메이션
    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = wrapper
    local tween = TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0.3 })
    tween:Play()
    tween.Completed:Connect(function()
        wrapper.Visible = false
        wrapper.BackgroundTransparency = 1
        if scale.Parent then scale:Destroy() end
        logoBtn.Visible = true

        --  로고 등장 애니메이션
        logoBtn.Size = UDim2.fromOffset(10, 10)
        TweenService:Create(logoBtn, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Size = UDim2.fromOffset(LOGO_SIZE, LOGO_SIZE) }):Play()
    end)
end

local function restoreUI()
    if not isMinimized then return end
    isMinimized = false

    logoBtn.Visible = false

    --  로고 위치에 UI를 배치
    wrapper.Position = logoBtn.Position
    wrapper.Size = UDim2.fromOffset(calculatePhoneSize())
    wrapper.Visible = true

    local scale = Instance.new("UIScale")
    scale.Scale = 0.3
    scale.Parent = wrapper
    local tween = TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = 1 })
    tween:Play()
    tween.Completed:Connect(function()
        if scale.Parent then scale:Destroy() end
    end)
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if isMinimized then
            restoreUI()
        else
            minimizeUI()
        end
    end
    if input.KeyCode == Enum.KeyCode.K then
        getgenv().SimpleAimESP_Unload()
    end
end)

--==========================================================================
--  ★ 드래그 (완전히 새로 구현 - UserInputService 기반)
--==========================================================================
local dragActive = false
local dragOrigin = nil
local dragStartPos = nil

local function beginDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragActive = true
        dragOrigin = input.Position
        dragStartPos = wrapper.Position
    end
end

local function endDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragActive = false
        dragOrigin = nil
        dragStartPos = nil
    end
end

--  드래그 시작 대상들
dragBar.InputBegan:Connect(beginDrag)
notch.InputBegan:Connect(beginDrag)
dragHint.InputBegan:Connect(beginDrag)

--  드래그 중 (UserInputService의 InputChanged에서 감지)
UserInputService.InputChanged:Connect(function(input)
    if not dragActive then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    if not dragOrigin or not dragStartPos then return end

    local delta = input.Position - dragOrigin
    wrapper.Position = UDim2.new(
        dragStartPos.X.Scale,
        dragStartPos.X.Offset + delta.X,
        dragStartPos.Y.Scale,
        dragStartPos.Y.Offset + delta.Y
    )
    --  로고도 같이 이동
    if logoBtn.Visible then
        logoBtn.Position = wrapper.Position
    end
end)

--  드래그 종료 (어디서 놓아도)
UserInputService.InputEnded:Connect(endDrag)

