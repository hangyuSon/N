local function slideIn(page)
    page.Visible = true
    page.Position = UDim2.fromScale(1, 0)
    TweenService:Create(page,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Position = UDim2.fromScale(0, 0) }):Play()
end

local function slideOut(page)
    local tween = TweenService:Create(page,
        TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        { Position = UDim2.fromScale(1, 0) })
    tween.Completed:Connect(function() page.Visible = false end)
    tween:Play()
end

local function openAim()
    if espPage.Visible then slideOut(espPage) end
    appsHome.Visible = false
    slideIn(aimPage)
end

local function openEsp()
    if aimPage.Visible then slideOut(aimPage) end
    appsHome.Visible = false
    slideIn(espPage)
end

